  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "@{outline.hex}",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"],
      "settings": {
        "foreground": "@{secondary.hex}"
      }
    },
    {
      "name": "Number",
      "scope": ["constant.numeric", "constant.language.boolean"],
      "settings": {
        "foreground": "@{tertiary.hex}"
      }
    },
    {
      "name": "Constant",
      "scope": ["constant", "constant.language", "constant.character"],
      "settings": {
        "foreground": "@{error.hex}"
      }
    },
    {
      "name": "Keyword",
      "scope": ["keyword", "keyword.control", "keyword.operator.new", "keyword.operator.expression", "keyword.operator.logical", "keyword.operator.delete", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "@{tertiary.hex}"
      }
    },
    {
      "name": "Operator",
      "scope": ["keyword.operator", "punctuation.separator", "punctuation.accessor"],
      "settings": {
        "foreground": "@{onSurfaceVariant.hex}"
      }
    },
    {
      "name": "Function",
      "scope": ["entity.name.function", "meta.function-call", "support.function"],
      "settings": {
        "foreground": "@{primary.hex}"
      }
    },
    {
      "name": "Method",
      "scope": ["meta.method.declaration", "entity.name.method"],
      "settings": {
        "foreground": "@{primary.hex}"
      }
    },
    {
      "name": "Class",
      "scope": ["entity.name.class", "entity.name.type.class", "support.class"],
      "settings": {
        "foreground": "@{secondary.hex}"
      }
    },
    {
      "name": "Type",
      "scope": ["entity.name.type", "support.type", "storage.type.primitive"],
      "settings": {
        "foreground": "@{secondary.hex}"
      }
    },
    {
      "name": "Interface",
      "scope": ["entity.name.type.interface"],
      "settings": {
        "foreground": "@{secondary.hex}",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variable",
      "scope": ["variable", "variable.other", "variable.language"],
      "settings": {
        "foreground": "@{onSurface.hex}"
      }
    },
    {
      "name": "Variable Constant",
      "scope": ["variable.other.constant"],
      "settings": {
        "foreground": "@{error.hex}"
      }
    },
    {
      "name": "Variable Property",
      "scope": ["variable.other.property", "variable.other.object.property"],
      "settings": {
        "foreground": "@{onSurface.hex}"
      }
    },
    {
      "name": "Parameter",
      "scope": ["variable.parameter"],
      "settings": {
        "foreground": "@{tertiary.hex}",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Property",
      "scope": ["support.type.property-name", "meta.object-literal.key"],
      "settings": {
        "foreground": "@{onSurface.hex}"
      }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": {
        "foreground": "@{tertiary.hex}"
      }
    },
    {
      "name": "Attribute",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "@{secondary.hex}",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Selector",
      "scope": ["entity.other.attribute-name.class", "entity.other.attribute-name.id"],
      "settings": {
        "foreground": "@{primary.hex}"
      }
    },
    {
      "name": "CSS Property",
      "scope": ["support.type.property-name.css", "support.type.vendored.property-name"],
      "settings": {
        "foreground": "@{onSurface.hex}"
      }
    },
    {
      "name": "CSS Value",
      "scope": ["support.constant.property-value", "meta.property-value", "support.constant.font-name"],
      "settings": {
        "foreground": "@{tertiary.hex}"
      }
    },
    {
      "name": "CSS Unit",
      "scope": ["keyword.other.unit"],
      "settings": {
        "foreground": "@{error.hex}"
      }
    },
    {
      "name": "Regex",
      "scope": ["string.regexp"],
      "settings": {
        "foreground": "@{error.hex}"
      }
    },
    {
      "name": "Escape Character",
      "scope": ["constant.character.escape"],
      "settings": {
        "foreground": "@{tertiary.hex}"
      }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation.definition", "punctuation.section", "meta.brace"],
      "settings": {
        "foreground": "@{onSurfaceVariant.hex}"
      }
    },
    {
      "name": "Markdown Heading",
      "scope": ["markup.heading", "entity.name.section.markdown"],
      "settings": {
        "foreground": "@{tertiary.hex}",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Bold",
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "@{primary.hex}",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Italic",
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "@{secondary.hex}",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown Link",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": {
        "foreground": "@{primary.hex}"
      }
    },
    {
      "name": "Markdown Code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block", "fenced_code.block.language"],
      "settings": {
        "foreground": "@{primary.hex}"
      }
    },
    {
      "name": "Markdown Quote",
      "scope": ["markup.quote"],
      "settings": {
        "foreground": "@{outline.hex}",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown List Punctuation",
      "scope": ["punctuation.definition.list.begin.markdown"],
      "settings": {
        "foreground": "@{secondary.hex}"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "@{onError.hex}",
        "background": "@{error.hex}"
      }
    },
    {
      "name": "Deprecated",
      "scope": ["invalid.deprecated"],
      "settings": {
        "foreground": "@{onTertiaryContainer.hex}",
        "background": "@{tertiaryContainer.hex}"
      }
    },
    {
      "name": "Inserted",
      "scope": ["markup.inserted"],
      "settings": {
        "foreground": "@{primary.hex}"
      }
    },
    {
      "name": "Deleted",
      "scope": ["markup.deleted"],
      "settings": {
        "foreground": "@{error.hex}"
      }
    },
    {
      "name": "Changed",
      "scope": ["markup.changed"],
      "settings": {
        "foreground": "@{tertiary.hex}"
      }
    },
    {
      "name": "JSON Key",
      "scope": ["support.type.property-name.json"],
      "settings": {
        "foreground": "@{onSurface.hex}"
      }
    },
    {
      "name": "JSON String Value",
      "scope": ["string.quoted.double.json"],
      "settings": {
        "foreground": "@{secondary.hex}"
      }
    },
    {
      "name": "YAML Key",
      "scope": ["entity.name.tag.yaml"],
      "settings": {
        "foreground": "@{onSurface.hex}"
      }
    },
    {
      "name": "INI Section",
      "scope": ["entity.name.section.group-title.ini"],
      "settings": {
        "foreground": "@{tertiary.hex}",
        "fontStyle": "bold"
      }
    },
    {
      "name": "INI Key",
      "scope": ["keyword.other.definition.ini"],
      "settings": {
        "foreground": "@{onSurface.hex}"
      }
    },
    {
      "name": "Shell Variable",
      "scope": ["variable.other.normal.shell", "variable.other.positional.shell", "variable.other.bracket.shell"],
      "settings": {
        "foreground": "@{onSurface.hex}"
      }
    },
    {
      "name": "Shell Command",
      "scope": ["support.function.builtin.shell", "entity.name.command.shell"],
      "settings": {
        "foreground": "@{secondary.hex}"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "@{onSurfaceVariant.hex}",
    "type": "@{secondary.hex}",
    "class": "@{secondary.hex}",
    "interface": { "foreground": "@{secondary.hex}", "fontStyle": "italic" },
    "struct": "@{secondary.hex}",
    "enum": "@{secondary.hex}",
    "enumMember": "@{tertiary.hex}",
    "typeParameter": "@{tertiary.hex}",
    "function": "@{primary.hex}",
    "method": "@{primary.hex}",
    "decorator": "@{primary.hex}",
    "macro": "@{primary.hex}",
    "variable": "@{onSurface.hex}",
    "variable.readonly": "@{tertiary.hex}",
    "variable.defaultLibrary": "@{tertiary.hex}",
    "parameter": { "foreground": "@{tertiary.hex}", "fontStyle": "italic" },
    "property": "@{onSurface.hex}",
    "property.readonly": "@{tertiary.hex}",
    "label": "@{onSurfaceVariant.hex}",
    "comment": { "foreground": "@{outline.hex}", "fontStyle": "italic" },
    "string": "@{secondary.hex}",
    "number": "@{tertiary.hex}",
    "regexp": "@{error.hex}",
    "operator": "@{onSurfaceVariant.hex}",
    "keyword": "@{tertiary.hex}"
  }
}
