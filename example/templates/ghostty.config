# Ghostty Material You Theme
# Generated by MeowterialYou

font-family = @{system_monospace_font}
font-size = @{system_monospace_font_size}

foreground = @{onSurface.hex}
background = @{surface.hex}
cursor-color = @{primary.hex}
selection-background = @{primaryContainer.hex}
selection-foreground = @{onPrimaryContainer.hex}

# 16-color ANSI Palette

# black
palette = 0=@{term_black}
palette = 8=@{term_bright_black}
# red
palette = 1=@{term_red}
palette = 9=@{term_bright_red}
# green
palette = 2=@{term_green}
palette = 10=@{term_bright_green}
# yellow
palette = 3=@{term_yellow}
palette = 11=@{term_bright_yellow}
# blue
palette = 4=@{term_blue}
palette = 12=@{term_bright_blue}
# magenta
palette = 5=@{term_magenta}
palette = 13=@{term_bright_magenta}
# cyan
palette = 6=@{term_cyan}
palette = 14=@{term_bright_cyan}
# white
palette = 7=@{term_white}
palette = 15=@{term_bright_white}

# Transparency & Blur
background-opacity = @{opacity}
background-blur = true

# Window Layout
window-padding-x = 12
window-padding-y = 12
window-inherit-font-size = true

# Native Decorations
window-theme = auto
window-decoration = true
