{
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "./src",
    "sourceMap": false,
    "strict": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "noEmit": false,
    "declaration": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "paths": {
      "gi://Gtk": ["./node_modules/@girs/gtk-4.0/gtk-4.0.d.ts"],
      "gi://Adw": ["./node_modules/@girs/adw-1/adw-1.d.ts"],
      "gi://Gio": ["./node_modules/@girs/gio-2.0/gio-2.0.d.ts"],
      "gi://GLib": ["./node_modules/@girs/glib-2.0/glib-2.0.d.ts"],
      "gi://GObject": ["./node_modules/@girs/gobject-2.0/gobject-2.0.d.ts"],
      "gi://St": ["./node_modules/@girs/st-15/st-15.d.ts"],
      "gi://Clutter": ["./node_modules/@girs/clutter-15/clutter-15.d.ts"],
      "gi://Shell": ["./node_modules/@girs/gnome-shell/dist/shell-0.1.d.ts"],
      "gi://Pango": ["./node_modules/@girs/pango-1.0/pango-1.0.d.ts"],
      "gi://GWeather": ["./node_modules/@girs/gweather-4.0/gweather-4.0.d.ts"],
      "resource:///org/gnome/shell/extensions/extension.js": ["./node_modules/@girs/gnome-shell/dist/extensions/extension.d.ts"],
      "resource:///org/gnome/Shell/Extensions/js/extensions/prefs.js": ["./node_modules/@girs/gnome-shell/dist/extensions/prefs.d.ts"],
      "resource:///org/gnome/shell/ui/main.js": ["./node_modules/@girs/gnome-shell/dist/ui/main.d.ts"],
      "resource:///org/gnome/shell/misc/weather.js": ["./node_modules/@girs/gnome-shell/dist/misc/weather.d.ts"],
      "resource:///org/gnome/shell/misc/fileUtils.js": ["./node_modules/@girs/gnome-shell/dist/misc/fileUtils.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
